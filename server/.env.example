# Alibaba Cloud Tingwu (通义听悟) API
TINGWU_ACCESS_KEY_ID=your_access_key_id
TINGWU_ACCESS_KEY_SECRET=your_access_key_secret
TINGWU_APP_KEY=your_app_key

# Database (Supabase PostgreSQL)
# Get from Supabase Dashboard > Settings > Database > Connection string
# Choose "URI" format, use Transaction Pooler (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Local development (SQLite alternative)
# DATABASE_URL=sqlite+aiosqlite:///./echomark.db

# Supabase Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Service Role Key (服务端操作，请妥善保管)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Configuration
HOST=0.0.0.0
PORT=8000
